# ==========================================================
# PocketWise AI – Environment Variables
# ==========================================================
# 1. Server-side AI Key (NEVER prefix with NEXT_PUBLIC_)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Session Signing Secret (used for local session cookies)
# Generate any random 32+ character string for production
SESSION_SECRET=replace-with-a-random-32-char-secret-key

# 3. Optional Supabase Cloud Integration
# When omitted, PocketWise AI automatically runs with its
# built-in local persistent server database (.data/pocketwise.json).
# When provided, PocketWise AI connects to Supabase Auth & Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
